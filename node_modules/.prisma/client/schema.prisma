datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model ChatSession {
  id               String         @id @default(cuid())
  sessionTokenHash String         @unique
  createdAt        DateTime       @default(now())
  expiresAt        DateTime
  lastActivityAt   DateTime       @default(now())
  conversations    Conversation[]
}

model Conversation {
  id                    String                @id @default(cuid())
  publicTicketReference String                @unique
  sessionId             String
  mode                  String                @default("AI_ACTIVE")
  status                String                @default("open")
  serviceCategory       String?
  customerName          String?
  customerEmail         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  session               ChatSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages              Message[]
  handoff               HumanHandoff?
  telegramMapping       TelegramTopicMapping?
  outboundEvents        OutboundEvent[]
  auditLogs             AuditLog[]

  @@index([sessionId])
  @@index([mode])
  @@index([status])
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  senderType        String
  channel           String       @default("website")
  content           String
  providerMessageId String?
  clientMessageId   String?
  deliveryStatus    String       @default("delivered")
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model HumanHandoff {
  id               String       @id @default(cuid())
  conversationId   String       @unique
  consentTimestamp DateTime     @default(now())
  status           String       @default("requested")
  acceptedAt       DateTime?
  closedAt         DateTime?
  assignedAgentId  String?
  summary          String?
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status])
}

model TelegramTopicMapping {
  id                      String       @id @default(cuid())
  conversationId          String       @unique
  telegramGroupChatId     String
  telegramMessageThreadId Int
  telegramTopicName       String
  createdAt               DateTime     @default(now())
  closedAt                DateTime?
  conversation            Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([telegramGroupChatId, telegramMessageThreadId])
  @@index([telegramGroupChatId, telegramMessageThreadId])
}

model TelegramWebhookEvent {
  id               String    @id @default(cuid())
  updateId         Int       @unique
  eventType        String
  processingStatus String    @default("processed")
  rawPayload       String?
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  @@index([updateId])
}

model OutboundEvent {
  id             String       @id @default(cuid())
  conversationId String
  eventType      String
  payload        String
  idempotencyKey String       @unique
  retryCount     Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  status         String       @default("pending")
  lastError      String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([conversationId])
}

model AuditLog {
  id             String        @id @default(cuid())
  conversationId String?
  eventType      String
  actorType      String
  actorId        String?
  details        String?
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([eventType])
  @@index([createdAt])
}
